{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(.+\\.)?vercel\\.app"
        }
      ],
      "destination": "https://www.satrapacafe.com/:path*",
      "statusCode": 301
    }
  ]
}
